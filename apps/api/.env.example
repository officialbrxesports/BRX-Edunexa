NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Neon: use the DIRECT / non-pooled one)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Website addresses allowed to call the API (comma separated, no wildcard)
CORS_ORIGINS=http://localhost:3001

# Production only: how many proxies sit in front of the API (Render = 1)
TRUST_PROXY_HOPS=0

# Google sign-in (client id only, not a secret)
GOOGLE_CLIENT_ID=

# Optional: where admission documents are stored on disk
# ADMISSION_UPLOAD_DIR=
