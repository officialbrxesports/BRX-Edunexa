# Application environment and HTTP server
NODE_ENV=development
PORT=3000

# PostgreSQL database connections
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE?sslmode=require

# Authentication configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# Web application URL and permitted browser origins
WEB_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# Google OAuth client configuration
GOOGLE_CLIENT_ID=your_google_client_id

# SMTP email delivery configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=replace_with_dummy_password
EMAIL_FROM=BRX EduNexa <noreply@example.com>
EMAIL_DAILY_LIMIT=100

# Initial platform administrator configuration
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_password

# Contact form recipient
CONTACT_TO_EMAIL=contact@example.com