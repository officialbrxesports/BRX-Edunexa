generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  HEAD
  TEACHER
  STUDENT
  STAFF
  ADMIN
}

enum InstitutionCategory {
  SCHOOL
  COLLEGE
  UNIVERSITY
  COACHING
  INSTITUTE
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  INVITE_ACCEPT
  SUSPEND
  ACTIVATE
}

model Institution {
  id        String            @id
  name      String
  idPrefix  String            @unique @db.VarChar(3)
  category  InstitutionCategory
  status    InstitutionStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  profile              InstitutionProfile?
  users                User[]
  invitations          Invitation[]
  classes              ClassRoom[]
  sections             Section[]
  subjects             Subject[]
  enrollments          Enrollment[]
  teacherAssignments   TeacherAssignment[]
  attendanceRecords    Attendance[]
  assignments          Assignment[]
  submissions          Submission[]
  exams                Exam[]
  examResults          ExamResult[]
  notices              Notice[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  rolePermissions      RolePermission[]
  auditEvents          AuditEvent[]

  @@index([status])
  @@index([category])
}

model InstitutionProfile {
  id             String      @id
  institutionId  String      @unique
  address        String?
  phone          String?
  contactEmail   String?
  website        String?
  timezone       String      @default("Asia/Kolkata")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

model User {
  id              String    @id
  institutionId   String?
  name            String
  email           String    @unique
  eduNexaId       String?   @unique @db.VarChar(12)
  passwordHash    String?
  role            UserRole
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institution           Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  sessions              Session[]
  sentInvitations       Invitation[] @relation("InvitationSender")
  createdClasses        ClassRoom[]  @relation("ClassCreator")
  enrollments           Enrollment[] @relation("EnrolledStudent")
  teacherAssignments    TeacherAssignment[] @relation("AssignedTeacher")
  attendanceRecords     Attendance[] @relation("AttendanceStudent")
  markedAttendance      Attendance[] @relation("AttendanceMarker")
  createdAssignments    Assignment[] @relation("AssignmentCreator")
  submissions           Submission[] @relation("SubmissionStudent")
  createdExams          Exam[] @relation("ExamCreator")
  examResults           ExamResult[] @relation("ExamStudent")
  createdNotices        Notice[] @relation("NoticeCreator")
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditEvents           AuditEvent[] @relation("AuditActor")

  @@index([institutionId])
  @@index([institutionId, role, isActive])
}

model Session {
  id         String    @id
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Invitation {
  id             String           @id
  institutionId  String
  invitedById    String
  email          String
  role           UserRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([institutionId, email, status])
  @@index([expiresAt])
}

model ClassRoom {
  id             String   @id
  institutionId  String
  name           String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("ClassCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections          Section[]
  enrollments       Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendanceRecords Attendance[]
  assignments       Assignment[]
  exams             Exam[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Section {
  id             String   @id
  institutionId  String
  classRoomId    String
  name           String
  createdAt      DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classRoom   ClassRoom   @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([classRoomId, name])
  @@index([institutionId])
}

model Subject {
  id             String   @id
  institutionId  String
  name           String
  code           String?
  createdAt      DateTime @default(now())

  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  assignments        Assignment[]
  exams              Exam[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Enrollment {
  id             String   @id
  institutionId  String
  studentId      String
  classRoomId    String
  sectionId      String?
  enrolledAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     User        @relation("EnrolledStudent", fields: [studentId], references: [id], onDelete: Restrict)
  classRoom   ClassRoom   @relation(fields: [classRoomId], references: [id], onDelete: Restrict)
  section     Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([studentId, classRoomId])
  @@index([institutionId])
  @@index([institutionId, classRoomId])
}

model TeacherAssignment {
  id             String   @id
  institutionId  String
  teacherId      String
  classRoomId    String
  subjectId      String?
  createdAt      DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacher     User        @relation("AssignedTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  classRoom   ClassRoom   @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject     Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([teacherId, classRoomId, subjectId])
  @@index([institutionId])
  @@index([institutionId, teacherId])
}

model Attendance {
  id             String           @id
  institutionId  String
  studentId      String
  classRoomId    String
  markedById     String
  date           DateTime         @db.Date
  status         AttendanceStatus
  note           String?
  createdAt      DateTime         @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     User        @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Restrict)
  classRoom   ClassRoom   @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  markedBy    User        @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([studentId, classRoomId, date])
  @@index([institutionId])
  @@index([institutionId, date])
}

model Assignment {
  id             String           @id
  institutionId  String
  classRoomId    String
  subjectId      String?
  createdById    String
  title          String
  description    String?
  status         AssignmentStatus @default(DRAFT)
  dueAt          DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classRoom   ClassRoom    @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([institutionId])
  @@index([institutionId, classRoomId, status])
}

model Submission {
  id             String   @id
  institutionId  String
  assignmentId   String
  studentId      String
  content        String?
  submittedAt    DateTime @default(now())
  score          Decimal? @db.Decimal(7, 2)
  feedback       String?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignment  Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     User        @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([institutionId])
}

model Exam {
  id             String   @id
  institutionId  String
  classRoomId    String
  subjectId      String?
  createdById    String
  title          String
  startsAt       DateTime?
  totalMarks     Decimal? @db.Decimal(7, 2)
  createdAt      DateTime @default(now())

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classRoom   ClassRoom    @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  results     ExamResult[]

  @@index([institutionId])
  @@index([institutionId, startsAt])
}

model ExamResult {
  id             String   @id
  institutionId  String
  examId         String
  studentId      String
  marksObtained  Decimal? @db.Decimal(7, 2)
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User        @relation("ExamStudent", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([institutionId])
}

model Notice {
  id             String   @id
  institutionId  String
  createdById    String
  title          String
  body           String
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([institutionId, publishedAt])
}

model Notification {
  id             String    @id
  institutionId  String
  userId         String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([userId, readAt, createdAt])
}

model PasswordResetToken {
  id             String   @id
  institutionId  String?
  userId         String
  tokenHash      String   @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id             String   @id
  institutionId  String?
  userId         String
  tokenHash      String   @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([userId, expiresAt])
}

model Feature {
  id          String   @id
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id             String   @id
  institutionId  String
  role           UserRole
  featureId      String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feature     Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([institutionId, role, featureId])
  @@index([institutionId])
}

model AuditEvent {
  id             String      @id
  institutionId  String?
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actor       User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([institutionId, createdAt])
  @@index([actorId, createdAt])
}
