  originalName  String
  mimeType      String
  sizeBytes     Int
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application   college_applications @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file          college_application_files?

  @@index([applicationId])
}

model college_application_files {
  documentId String                        @id
  data       Bytes
  document   college_application_documents @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model staff_applications {
